{
  //Cpu
"cpu": {
    "interval": 10,
    "format": " {usage}%",
    "max-length": 10
},
// Memory
"memory": {
  "interval": 10,
  "format": "  {avail} G"
},
  //Temp
 "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    // "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C ",
    "format": " {temperatureC}°C"
},
  //Storage
  "disk": {
    "interval": 30,
    "format": "  {percentage_used}%",
    "path": "/"
},

  //Media
"mpris": {
  "format": "{player_icon} {title} - {artist}",
  "format-paused": "{status_icon} {title} - {artist}",
  "max-length": 30
},

  //Workspaces
  "hyprland/workspaces": {
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [], // Always show a workspace with name '3', on all outputs if it does not exists
        "4": [], 
        "5": [], 
        "6": [],
        "7": [],
        "8": [],
        "9": [],
       "10": []
    }
},

  //Date+Time
  "clock": {
    "format": "{:%I:%M:%S %p}",
    "interval": 1
  },

  //SS
  // Screenshot
"custom/screenshot": {
  "format": "󰻜 ",
  "tooltip": "Screenshot (select area)",
  "on-click": "grim -g \"$(slurp)\" - | wl-copy"
},

  //Color Picker
"custom/colorpicker": {
  "format": " ",
  "tooltip": "Pick a color",
  "on-click": "hyprpicker -a"
},


  //Apps
"tray": {
  "spacing": 8
}

  //Mute

  //Wifi
  
  //Notification

  //Menu
}
